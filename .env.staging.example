# Copy this file to .env and fill in the values for staging.
# NEVER commit .env to git.

NODE_ENV=staging
# PORT is set automatically by Render — omit this on Render, keep for local

# ── Database & Cache ──────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/flight-booking?retryWrites=true&w=majority
REDIS_URL=redis://default:<password>@<host>:<port>

# ── Auth ──────────────────────────────────────────────────────────────────────
# Use a long random string (openssl rand -hex 64) — NOT a JWT token
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800
JWT_RESET_EXPIRY=1800
ADMIN_JWT_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_WHITELIST=https://skybook-frontend.vercel.app
ADMIN_CORS_ORIGIN=https://skybook-admin.vercel.app

# ── App URLs ──────────────────────────────────────────────────────────────────
APP_BASE_URL=https://skybook-frontend.vercel.app
SUPPORT_EMAIL=amit.kumar.travels1@gmail.com

# ── Travelport (pre-production / sandbox) ────────────────────────────────────
TRAVELPORT_CLIENT_ID=
TRAVELPORT_CLIENT_SECRET=
TRAVELPORT_USERNAME=
TRAVELPORT_PASSWORD=
TRAVELPORT_ACCESS_GROUP=
TRAVELPORT_BASE_URL=https://api.pp.travelport.net
TRAVELPORT_AUTH_URL=https://auth.pp.travelport.net/oauth/token
TRAVELPORT_API_VERSION=11
TRAVELPORT_TIMEOUT_MS=30000

# ── GDS Providers ─────────────────────────────────────────────────────────────
INDIGO_USERNAME=
INDIGO_PASSWORD=
INDIGO_TARGET_BRANCH=
AKASA_TEST_URL=
AKASA_TEST_USERNAME=
AKASA_TEST_PASSWORD=
AKASA_TEST_DOMAIN=

# ── Payments (test keys) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SkyBook <your-email@gmail.com>

# ── WhatsApp (MyOperator stage) ───────────────────────────────────────────────
MYOPERATOR_API_URL=https://publicapi.myoperator-stage.co/chat/messages
MYOPERATOR_TOKEN=
MYOPERATOR_COMPANY_ID=
MYOPERATOR_PHONE_NUMBER_ID=
MYOPERATOR_BOOKING_TEMPLATE_ID=
MYOPERATOR_CANCELLATION_TEMPLATE_ID=

# ── OpenAI (optional — leave blank to disable AI features) ───────────────────
OPENAI_API_KEY=
